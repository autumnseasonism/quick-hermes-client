{
  "name": "quick-hermes-client",
  "version": "1.0.0",
  "description": "A lightweight floating macOS client for Hermes Agent.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js",
    "pack": "electron-builder --mac --dir",
    "dist": "electron-builder --mac"
  },
  "keywords": [
    "hermes-agent",
    "electron",
    "macos",
    "floating-window",
    "ai-agent"
  ],
  "author": "OpenAI Codex",
  "homepage": "https://github.com/comeonzhj/quick-hermes-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comeonzhj/quick-hermes-client.git"
  },
  "bugs": {
    "url": "https://github.com/comeonzhj/quick-hermes-client/issues"
  },
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.quickhermes.client",
    "productName": "Quick Hermes",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  }
}
